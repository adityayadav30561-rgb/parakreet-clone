# API keys are entered in the app's Settings screen and stored encrypted (Windows DPAPI).
# This file documents the providers only; the packaged app does NOT read a .env file.
# For local dev convenience you may set keys here, but never commit a real .env.

# Speech-to-text
GROQ_API_KEY=
ASSEMBLYAI_API_KEY=
DEEPGRAM_API_KEY=

# Answer LLM
GEMINI_API_KEY=
OPENAI_API_KEY=
CEREBRAS_API_KEY=
