{
  "name": "@ria/desktop",
  "productName": "Realtime Interview Assistant",
  "version": "0.1.0",
  "private": true,
  "description": "Realtime Interview Assistant desktop app (Electron).",
  "author": "Realtime Interview Assistant contributors",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc -p tsconfig.node.json && tsc -p tsconfig.web.json",
    "test:e2e": "playwright test",
    "package": "electron-vite build && electron-builder --dir",
    "package:win": "electron-vite build && electron-builder --win portable --x64"
  },
  "devDependencies": {
    "@playwright/test": "~1.63",
    "@ria/shared": "^0.1.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "vite": "~7.3"
  }
}
